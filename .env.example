# ──────────────────────────────────────────
# Required — the only mandatory setting
# ──────────────────────────────────────────

LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-v4-flash

# ──────────────────────────────────────────
# Data & index (sensible defaults — usually leave alone)
# ──────────────────────────────────────────

# RWR data root. Either a single package directory (contains package_config.xml,
# e.g. ./data/GFL_Castling) or a directory of packages (e.g. ./ww2-data, which holds
# ww2_base / edelweiss / pacific / …). Packages are discovered automatically.
DATA_DIR=./data

# Where the generated indexes live (graph.json, script-symbols.json, search-index.json).
# OUTPUT_DIR=./output

# Build/refresh the index at startup when it is missing or the data changed.
# Set to false to require an explicit `npm run build:index`.
# AUTO_BUILD_INDEX=true

# Override individual index paths (default: <OUTPUT_DIR>/<name>).
# GRAPH_PATH=./output/graph.json
# SEARCH_INDEX_PATH=./output/search-index.json

# ──────────────────────────────────────────
# Optional — LLM tuning
# ──────────────────────────────────────────

# reasoning_effort: leave empty to omit, or one of: minimal | low | medium | high
# LLM_REASONING_EFFORT=
# thinking switch: true -> {type:'enabled'}, false -> {type:'disabled'}, unset -> field omitted
# LLM_THINKING_ENABLED=true
# temperature: unset = model default
# LLM_TEMPERATURE=0.3
# Max generated output tokens (reasoning + answer share this budget). Default 32768.
# LLM_MAX_OUTPUT_TOKENS=32768
# MAX_CONTEXT_TOKENS=500000

# ──────────────────────────────────────────
# Optional — Session memory
# ──────────────────────────────────────────

# SUMMARY_INTERVAL_TURNS=3
# SUMMARY_MODEL=deepseek-v4-flash

# ──────────────────────────────────────────
# Optional — Observability
# ──────────────────────────────────────────

# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ──────────────────────────────────────────
# Server
# ──────────────────────────────────────────

PORT=3000
