# ──────────────────────────────────────────
# Required — the only mandatory setting
# ──────────────────────────────────────────

LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-v4-flash

# Models offered to the client (GET /v1/models) and accepted in `body.model`, comma-separated.
# The UI's model switcher only shows these; requests naming anything else fall back to LLM_MODEL.
# LLM_MODELS=deepseek-v4-flash,deepseek-v4

# Friendly names for the model switcher — a mapping table in the Gemini Flash/Pro style, as
# id=Label pairs. The UI renders these labels; `body.model` keeps carrying the real id, so raw
# model ids never reach the page. Unlisted models fall back to their id.
# LLM_MODEL_LABELS=deepseek-v4-flash=Flash,deepseek-v4=Pro

# ──────────────────────────────────────────
# Data & index (sensible defaults — usually leave alone)
# ──────────────────────────────────────────

# RWR data root. Either a single package directory (contains package_config.xml,
# e.g. ./data/GFL_Castling) or a directory of packages (e.g. ./ww2-data, which holds
# ww2_base / edelweiss / pacific / …). Packages are discovered automatically.
DATA_DIR=./data

# Where the generated indexes live (graph.json, script-symbols.json, search-index.json).
# OUTPUT_DIR=./output

# Build/refresh the index at startup when it is missing or the data changed.
# Set to false to require an explicit `npm run build:index`.
# AUTO_BUILD_INDEX=true

# Override individual index paths (default: <OUTPUT_DIR>/<name>).
# The search index is two files: this header, plus a `search-index.ndjson` body beside it.
# GRAPH_PATH=./output/graph.json
# SEARCH_INDEX_PATH=./output/search-index.json

# Files the index build parses at once. Default: CPU count clamped to [2, 4].
# XML parsing is synchronous CPU work, so raising this past the core count buys no speed and
# only raises the build's peak memory — lower it to 2 on a memory-tight host, not higher.
# INDEX_CONCURRENCY=4

# ──────────────────────────────────────────
# Optional — Docker host paths
# ──────────────────────────────────────────
# Read by Compose for ${...} interpolation in docker-compose.override.yml, never by the
# app itself. Only needed if you mount packages straight out of a steamcmd install —
# copy docker-compose.override.yml.example and point these at it.

# RWR_PACKAGES_DIR=/home/steam/Steam/steamapps/common/RunningWithRifles/media/packages
# RWR_WORKSHOP_DIR=/home/steam/Steam/steamapps/workshop/content/270150

# Container resource ceilings, read by Compose. Keep NODE_OPTIONS' heap cap well under
# MEM_LIMIT: V8 otherwise sizes its old space from the host's RAM and an index build on a
# small box degenerates into GC thrash that takes the whole machine down with it.
# MEM_LIMIT=1g
# CPUS=1.5
# NODE_OPTIONS=--max-old-space-size=768

# ──────────────────────────────────────────
# Optional — Agent tool plugins
# ──────────────────────────────────────────

# Directory of runtime tool plugins (plain ESM .js). Skipped if it does not exist.
# ⚠️ Plugins run in-process with full server privileges — only put files you trust here.
# TOOLS_DIR=./tools.d

# Directory of skills: markdown playbooks appended to the system prompt when the question matches
# their declared triggers. Skipped if it does not exist. This is where a deployment's own domain
# knowledge belongs — a mod's quirks are a file you drop in, not an edit to the prompt in the repo.
# Unlike a plugin tool, a skill MUST declare triggers: hiding a tool costs the model an option it
# can ask for later, while an always-on skill is paid for in every turn's context.
# SKILLS_DIR=./skills.d

# Watch TOOLS_DIR and SKILLS_DIR, reloading changed files on the next request (never mid-turn).
# Defaults to on outside production.
# TOOLS_HOT_RELOAD=true

# Progressive tool disclosure. When built-ins + plugins exceed this many tools, the agent
# loop's first step only exposes the built-ins plus any plugin whose `triggers` matched the
# query (later steps always see everything). 0 disables disclosure. Default 12 — a no-op
# unless your tools.d grows past it. Plugins without a `triggers` field are never hidden.
# TOOL_DISCLOSURE_THRESHOLD=12

# ──────────────────────────────────────────
# Optional — LLM tuning
# ──────────────────────────────────────────

# reasoning_effort: leave empty to omit, or one of: minimal | low | medium | high
# LLM_REASONING_EFFORT=
# thinking switch: true -> {type:'enabled'}, false -> {type:'disabled'}, unset -> field omitted
# LLM_THINKING_ENABLED=true
# temperature: unset = model default
# LLM_TEMPERATURE=0.3
# Max generated output tokens (reasoning + answer share this budget). Default 32768.
# LLM_MAX_OUTPUT_TOKENS=32768
# MAX_CONTEXT_TOKENS=500000

# ──────────────────────────────────────────
# Optional — Network & access control
# ──────────────────────────────────────────

# Comma-separated allowed origins. Empty reflects whatever Origin the caller sends, which is the
# historical default and fine for a firewalled LAN box. Set this once the port is reachable elsewhere.
# CORS_ORIGINS=http://192.168.1.10:3000,https://rwr.example.com
# When set, every /v1/* request must send `Authorization: Bearer <token>` or `x-api-key`. /health and
# the static UI stay open. The bundled UI picks the token up from a one-time `?token=…` on the URL.
# API_TOKEN=

# Max rounds a single conversation may carry (one round = one question + its answer, counted from
# the history the client replays). The next question past the cap gets a 400 telling the user to
# start a new chat. This bounds thread length, not request rate — the whole history is re-sent on
# every turn and once per tool-loop step, so a never-ending thread is what actually burns quota.
# 0 disables the check. Default 20.
# MAX_CONVERSATION_ROUNDS=20

# ──────────────────────────────────────────
# Optional — Retrieved context size
# ──────────────────────────────────────────

# Token cap on the full text of retrieved documents in the prompt. Hits beyond it still appear as
# one-line summaries the model can expand with searchDocs/readSource, so an enumeration keeps complete
# coverage while the prompt stops growing. Sized so topK-30 queries are untouched and only enumeration
# is capped. Uncapped, a 150-result enumeration reached ~80K tokens re-sent on every step.
# CONTEXT_BUDGET_TOKENS=24000

# ──────────────────────────────────────────
# Optional — Agent tool transcript
# ──────────────────────────────────────────

# Tool results are replayed to the model in full. They are only shed once a step's prompt would
# occupy more than this fraction of the context window — with the default window that effectively
# never happens. Lower it only if the provider rejects oversized requests.
# TOOL_CONTEXT_BUDGET_RATIO=0.75
# Size an old tool result is shrunk to when shedding is unavoidable. Shrinking is structural (whole
# array items dropped, long strings clipped, a `_shed` note added), never a mid-JSON cut.
# TOOL_SHED_RESULT_TOKENS=600
# Deadline for a single tool execution. On expiry the tool returns a `{ error, hint }` the model can
# route around, so a hanging plugin or a pathological file read cannot stall the response stream.
# TOOL_TIMEOUT_MS=15000

# Runaway backstop for the agent tool loop, in LLM round-trips. 100 is deliberately loose: a
# reference or inheritance chain crossing several packages is sequential — each readSource depends on
# what the previous layer reported — and cutting it mid-walk yields a confidently wrong answer rather
# than a slow one. Note this counts STEPS, not tool calls: one step can fan out many parallel calls
# (measured: 15 calls in 9 steps). Lower it only if you want a hard ceiling and accept truncated
# answers; hitting it reports `stopReason: "step-limit"` rather than truncating silently.
# MAX_TOOL_STEPS=100

# Interval between keep-alive lines on the chat stream. A turn is silent for as long as its slowest
# phase (a cold first step, a tool call, the Max-mode judge), and whatever sits in front of the app
# reads that silence as a stalled origin: nginx's `proxy_read_timeout` defaults to 60s, Cloudflare
# cuts at 100s, Tencent EdgeOne's "HTTP response timeout" at 15s. The reset arrives after the 200 has
# been sent, so it reaches the browser as ERR_HTTP2_PROTOCOL_ERROR mid-answer instead of as a status
# code. Keep this well under the shortest timeout in front of the app. `0` disables it.
# STREAM_HEARTBEAT_MS=10000

# ──────────────────────────────────────────
# Optional — Best-of-N synthesis ("Max mode")
# ──────────────────────────────────────────

# Master switch for best-of-N. When on, a request with `mode: 'max'` (the UI's Max-mode toggle)
# runs N parallel candidate agent loops, then one synthesis ("judge") call merges them into the
# final answer. The normal single-path turn is untouched either way.
# BEST_OF_N_ENABLED=true

# Number of parallel candidate drafts (requests may override it per-call via `body.candidates`).
# BEST_OF_N=3

# Per-candidate agent step cap. The normal loop's 100-step stop is a runaway backstop, not a
# budget — a single question has measured 2.5M input tokens — and best-of-N multiplies that by N,
# so each candidate gets a deliberately tight cap. Cost guardrail; do not raise casually.
# BEST_OF_N_MAX_STEPS=6

# Candidate temperatures, comma-separated, cycled when fewer than N. Default 0.3,0.6,0.9.
# Reasoning models respond weakly to temperature — the diversity mostly comes from the tool paths.
# BEST_OF_N_TEMPERATURES=0.3,0.6,0.9

# Seed of the first candidate; each candidate adds its own index so the runs stay distinct.
# BEST_OF_N_SEED_BASE=1

# Model for the synthesis ("judge") call. Defaults to LLM_MODEL; set a stronger model if you have one.
# JUDGE_MODEL=deepseek-v4-flash

# ──────────────────────────────────────────
# Optional — Session memory
# ──────────────────────────────────────────

# SUMMARY_INTERVAL_TURNS=3
# SUMMARY_MODEL=deepseek-v4-flash

# ──────────────────────────────────────────
# Optional — Observability
# ──────────────────────────────────────────

# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ──────────────────────────────────────────
# Server
# ──────────────────────────────────────────

PORT=3000
