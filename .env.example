# ──────────────────────────────────────────
# Required
# ──────────────────────────────────────────

# LLM (Chat Completions) — the only required external API
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-v4-flash

# ──────────────────────────────────────────
# Local data / index paths (sensible defaults)
# ──────────────────────────────────────────

# Source data directory (for file-reading agent tools)
DATA_DIR=./data

# Index paths (generated by `npm run build:graph`)
GRAPH_PATH=./output/graph.json
SEARCH_INDEX_PATH=./output/search-index.json

# ──────────────────────────────────────────
# Optional — LLM tuning
# ──────────────────────────────────────────

# reasoning_effort: leave empty to omit, or one of: minimal | low | medium | high
# LLM_REASONING_EFFORT=
# thinking switch: true -> {type:'enabled'}, false -> {type:'disabled'}, unset -> field omitted
# LLM_THINKING_ENABLED=true
# temperature: unset = model default
# LLM_TEMPERATURE=0.3
# Max generated output tokens (reasoning + answer share this budget). Default 32768.
# LLM_MAX_OUTPUT_TOKENS=32768

# ──────────────────────────────────────────
# Optional — Cache & Memory
# ──────────────────────────────────────────

# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=600
# SUMMARY_INTERVAL_TURNS=3
# SUMMARY_MODEL=deepseek-v4-flash

# ──────────────────────────────────────────
# Optional — Observability
# ──────────────────────────────────────────

# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ──────────────────────────────────────────
# Server
# ──────────────────────────────────────────

PORT=3000

# ──────────────────────────────────────────
# Legacy (optional — only needed for extract/embed CLI)
# ──────────────────────────────────────────

# PostgreSQL + pgvector (only required for legacy extract/embed CLI, NOT for chat)
# DATABASE_URL=postgresql://rwr_agent:rwr_agent_secret@localhost:5432/rwr_agent
# DATABASE_PROVIDER=pg
# SILICONFLOW_API_KEY=sk-xxx
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSION=1024
