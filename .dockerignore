# Bare `node_modules` only matches the root entry — web/node_modules would
# otherwise ride along and drop host-arch native binaries into the builder.
**/node_modules
dist
.git
.gitignore
.env
.env.*
!.env.example
*.md
!README.md
!README_zh.md
data
Dockerfile
Dockerfile.postgres
docker-compose.yml
.dockerignore
*.log
.vscode
.idea
coverage
.nyc_output
