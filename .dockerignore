# Allowlist, not a denylist: exclude everything, then re-admit exactly the paths
# the Dockerfile COPYs. A denylist silently ships whatever the repo grows next —
# vanilla-data/, output/, .codegraph/ and friends added ~1.1 GB to the context.
#
# Adding a COPY to the Dockerfile means adding its source here too, or the build
# fails with "file not found" on an otherwise correct instruction.
*

# Builder stage: npm ci, the web bundle, then tsc.
!package.json
!package-lock.json
!tsconfig.json
!src
!web

# The agent-core workspace. `npm ci` needs its package.json present before it can link
# node_modules/@rwr/agent-core, in BOTH stages — the root package depends on it by name.
!packages

# Production stage: agent tool plugins, mounted read-only at runtime.
!tools.d

# Skills: operator-editable prompt playbooks, mounted read-only at runtime.
!skills.d

# The re-admits above pull in whole directories, so drop the parts of them that
# must never reach the builder: host-arch native modules and local build output.
**/node_modules
**/dist
**/.DS_Store
**/*.log
